# 이 파일을 복사해서 이름을 .env.local 로 바꾸고, 아래 두 값을 채운다.
# 값은 Supabase 대시보드 → Project Settings → API 에서 확인할 수 있다.
# (anon public 키는 브라우저에 공개되어도 되는 키다. service_role 키는 절대 넣지 말 것)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에-anon-public-키

# ---------- 몽실이 AI (서버 전용. NEXT_PUBLIC_ 이 아니므로 브라우저에 가지 않는다) ----------
# gemini 또는 ollama. 비워 두면 AI 없이 각본 대화만 한다.
AI_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey 에서 발급. 이 키는 비밀이다 (깃·채팅에 올리지 말 것)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama: 내 컴퓨터에서 ollama 를 켜 두고 쓸 때 (AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
